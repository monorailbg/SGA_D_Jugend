---
interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  open?: boolean;
  accent?: string;
}
const { title, subtitle, badge, open = false, accent } = Astro.props;
const uid = `acc-${Math.random().toString(36).slice(2, 9)}`;
---
<div class="accordion">
  <h3 class="accordion-heading">
    <button
      class:list={['accordion-trigger', { 'is-open': open }]}
      type="button"
      aria-expanded={open ? 'true' : 'false'}
      aria-controls={uid}
      style={accent ? `--accent:${accent}` : undefined}
    >
      <span class="accordion-trigger-text">
        <span class="accordion-title">{title}</span>
        {subtitle && <span class="accordion-subtitle">{subtitle}</span>}
      </span>
      {badge && <span class="accordion-badge" style={accent ? `background:${accent}` : undefined}>{badge}</span>}
      <svg class="accordion-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
  </h3>
  <div class:list={['accordion-panel', { 'is-open': open }]} id={uid}>
    <div class="accordion-inner">
      <div class="accordion-content">
        <slot />
      </div>
    </div>
  </div>
</div>

ht:auto;display:block\" viewBox=\"0 0 96 58\" role=\"img\"><defs><marker id=\"ahRun\" markerWidth=\"9\" markerHeight=\"9\" refX=\"6.5\" refY=\"3\" orient=\"auto\" markerUnits=\"userSpaceOnUse\"><path d=\"M0,0 L7,3 L0,6 Z\" fill=\"#1c2b22\"/></marker><marker id=\"ahPass\" markerWidth=\"9\" markerHeight=\"9\" refX=\"6.5\" refY=\"3\" orient=\"auto\" markerUnits=\"userSpaceOnUse\"><path d=\"M0,0 L7,3 L0,6 Z\" fill=\"#1f5fbf\"/></marker><marker id=\"ahShot\" markerWidth=\"9\" markerHeight=\"9\" refX=\"6.5\" refY=\"3\" orient=\"auto\" markerUnits=\"userSpaceOnUse\"><path d=\"M0,0 L7,3 L0,6 Z\" fill=\"#d23b3b\"/></marker><marker id=\"ahDrib\" markerWidth=\"9\" markerHeight=\"9\" refX=\"6.5\" refY=\"3\" orient=\"auto\" markerUnits=\"userSpaceOnUse\"><path d=\"M0,0 L7,3 L0,6 Z\" fill=\"#1c2b22\"/></marker><linearGradient id=\"grassG\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#3a8f4e\"/><stop offset=\"1\" stop-color=\"#34853f\"/></linearGradient></defs><rect x=\"0\" y=\"0\" width=\"96\" height=\"58\" rx=\"8\" fill=\"url(#grassG)\"/><path d=\"M20,29 L76,29\" fill=\"none\" stroke=\"#d23b3b\" stroke-width=\"3.4\" marker-end=\"url(#ahShot)\" stroke-linecap=\"round\"/></svg></div><span>Torschuss (rot, dick)</span></div><div class=\"legitem\"><div class=\"legsym\"><svg xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%;height:auto;display:block\" viewBox=\"0 0 96 58\" role=\"img\"><defs><marker id=\"ahRun\" markerWidth=\"9\" markerHeight=\"9\" refX=\"6.5\" refY=\"3\" orient=\"auto\" markerUnits=\"userSpaceOnUse\"><path d=\"M0,0 L7,3 L0,6 Z\" fill=\"#1c2b22\"/></marker><marker id=\"ahPass\" markerWidth=\"9\" markerHeight=\"9\" refX=\"6.5\" refY=\"3\" orient=\"auto\" markerUnits=\"userSpaceOnUse\"><path d=\"M0,0 L7,3 L0,6 Z\" fill=\"#1f5fbf\"/></marker><marker id=\"ahShot\" markerWidth=\"9\" markerHeight=\"9\" refX=\"6.5\" refY=\"3\" orient=\"auto\" markerUnits=\"userSpaceOnUse\"><path d=\"M0,0 L7,3 L0,6 Z\" fill=\"#d23b3b\"/></marker><marker id=\"ahDrib\" markerWidth=\"9\" markerHeight=\"9\" refX=\"6.5\" refY=\"3\" orient=\"auto\" markerUnits=\"userSpaceOnUse\"><path d=\"M0,0 L7,3 L0,6 Z\" fill=\"#1c2b22\"/></marker><linearGradient id=\"grassG\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#3a8f4e\"/><stop offset=\"1\" stop-color=\"#34853f\"/></linearGradient></defs><rect x=\"0\" y=\"0\" width=\"96\" height=\"58\" rx=\"8\" fill=\"url(#grassG)\"/><rect x=\"16\" y=\"12\" width=\"64\" height=\"34\" rx=\"4\" fill=\"#1f5fbf\" fill-opacity=\"0.16\" stroke=\"#ffffff\" stroke-width=\"1.4\" stroke-opacity=\"0.9\" stroke-dasharray=\"6 5\"/></svg></div><span>Zone / markierter Bereich</span></div></div>\n          <h3 style=\"margin-top:18px\">Abkürzungen</h3>\n          <div class=\"abkgrid\"><div class=\"abk\"><b>TW</b><span>Torwart</span></div><div class=\"abk\"><b>IV</b><span>Innenverteidiger</span></div><div class=\"abk\"><b>6</b><span>Sechser (zentrales Mittelfeld)</span></div><div class=\"abk\"><b>9</b><span>Spitze / Stürmer</span></div><div class=\"abk\"><b>Gold</b><span>leistungsstärkere Gruppe</span></div><div class=\"abk\"><b>Bronze</b><span>Gruppe mit mehr Übungsbedarf</span></div></div>\n        </div>\n        <div class=\"card pad\">\n          <h3>Schwerpunkt-Kategorien <span class=\"muted\">(Code c)</span></h3>\n          <div class=\"katrow\"><span class=\"chip\" style=\"background:#e8821e\">K</span><div><b>Koordination &amp; Athletik</b><small>Aktivierung, Lauf-ABC, Schnelligkeit, spielnahe Belastung</small></div></div><div class=\"katrow\"><span class=\"chip\" style=\"background:#0f9488\">T</span><div><b>Technik &amp; Ballbeherrschung</b><small>Ballführung, Dribbling, Finten, An-/Mitnahme, schwacher Fuß</small></div></div><div class=\"katrow\"><span class=\"chip\" style=\"background:#2f6fd0\">P</span><div><b>Passen &amp; Freilaufen</b><small>Passspiel, Anbieten, „spielen und gehen“</small></div></div><div class=\"katrow\"><span class=\"chip\" style=\"background:#3f51b5\">A</span><div><b>Spielaufbau &amp; Positionsspiel</b><small>Aufbau von hinten, Raumaufteilung, Nachrücken / „nicht abschalten“</small></div></div><div class=\"katrow\"><span class=\"chip\" style=\"background:#d23b3b\">Z</span><div><b>Zweikampf &amp; 1-gegen-1</b><small>offensiv/defensiv, Balleroberung</small></div></div><div class=\"katrow\"><span class=\"chip\" style=\"background:#ef6c00\">F</span><div><b>Torabschluss</b><small>Torschuss, Spiel vor dem Tor</small></div></div><div class=\"katrow\"><span class=\"chip\" style=\"background:#1f9d57\">S</span><div><b>Spielformen &amp; Umschalten</b><small>kleine Spielformen, Über-/Unterzahl, Transition, Abschlussspiele</small></div></div><div class=\"katrow\"><span class=\"chip\" style=\"background:#b8860b\">TW</span><div><b>Torwartspiel</b><small>Grundtechnik, Mitspielen (sparsam/integriert)</small></div></div>\n          <h3 style=\"margin-top:18px\">Die vier Slots (Code a)</h3>\n          <div class=\"katrow\"><span class=\"chip\" style=\"background:#e8821e\">Slot 1</span><div><b>Erwärmung / Aktivierung</b><small>Immer aktivierend, viele Ballkontakte, wenig Standzeit.</small></div></div><div class=\"katrow\"><span class=\"chip\" style=\"background:#2f6fd0\">Slot 2</span><div><b>Spielform + Schwerpunkt</b><small>50 % spezielle Spielform, 50 % Schwerpunkt der Saisonphase.</small></div></div><div class=\"katrow\"><span class=\"chip\" style=\"background:#7a4fd0\">Slot 3</span><div><b>Schwerpunkt</b><small>Technik-/Taktik-Schwerpunkt mit hoher Wiederholungszahl.</small></div></div><div class=\"katrow\"><span class=\"chip\" style=\"background:#1f9d57\">Slot 4</span><div><b>Abschlussspiel</b><small>Immer Spiel auf Tore, zu 50 % mit Sonderregel.</small></div></div>\n          <p class=\"muted small\" style=\"margin-top:14px\">Übungscode = <b>Kategorie&#8209;Nr</b>, z.&nbsp;B. <span class=\"ccode\" style=\"border-color:#2f6fd0\">P-01</span>. Kategorien: K·T·P·A·Z·F·S·TW. Katalog sortiert nach Kategorie.</p>\n        </div>\n      </div>"
}